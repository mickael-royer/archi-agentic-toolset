# Gemini API Configuration
GEMINI_API_KEY=your_api_key_here

# Optional: Override default model (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Cache TTL in seconds (default: 3600)
# LLM_CACHE_TTL=3600

# IcePanel C4 model source (ADR 0031): API key with read access to the landscape
ICEPANEL_API_KEY=your_icepanel_api_key_here
ICEPANEL_LANDSCAPE_ID=your_landscape_id_here
# Optional: version to score by default (default: latest)
# ICEPANEL_VERSION_ID=latest
